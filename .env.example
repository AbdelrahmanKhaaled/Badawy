# Copy to .env.local and fill in. Never commit real secrets.

# Public site URL (used for metadata / Open Graph)
NEXT_PUBLIC_SITE_URL=

# ---- Booking request delivery (/api/booking) ----
# At least ONE channel must be configured, otherwise the form shows a "contact us directly" fallback
# and never reports a successful submission.

# 1) Webhook: receives the structured JSON record (CRM, Zapier/Make, n8n, Google Apps Script, your backend…)
BOOKING_WEBHOOK_URL=
# Optional: sent as "Authorization: Bearer <secret>"
BOOKING_WEBHOOK_SECRET=

# 2) Email notification via Resend (https://resend.com). All three are required for this channel.
RESEND_API_KEY=
# Comma-separated recipients
BOOKING_NOTIFY_EMAIL=
# Must be a sender on a domain verified in Resend, e.g. "Badawy Productions <bookings@your-domain.com>"
BOOKING_FROM_EMAIL=

# ---- Social profiles (only verified URLs; icons are hidden while empty) ----
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# ---- Misc ----
# Set to false once stats/testimonials/client logos are verified to hide the "demo" tags
NEXT_PUBLIC_SHOW_DEMO_LABELS=true
NEXT_PUBLIC_THEME_FOLLOW_SYSTEM=false

# ---- Contact page map (configure ONE; nothing set = country-level map, no address shown) ----
NEXT_PUBLIC_MAP_EMBED_URL=
NEXT_PUBLIC_MAP_LAT=
NEXT_PUBLIC_MAP_LNG=
NEXT_PUBLIC_MAP_QUERY=
# Optional display text
NEXT_PUBLIC_LOCATION_LABEL=
NEXT_PUBLIC_LOCATION_ADDRESS=
